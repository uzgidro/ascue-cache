services:
  app:
    build: .
    container_name: ascue
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      - ./config.yaml:/app/config.yaml
    depends_on:
      - redis
    networks:
      - ascue

  redis:
    image: redis:7-alpine
    container_name: kpi-redis
    networks:
      - ascue

networks:
  ascue:
    driver: bridge
